{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/fees/:path*", "destination": "/index.html" },
    { "source": "/manager/:path*", "destination": "/index.html" },
    { "source": "/attendance/:path*", "destination": "/index.html" },
    { "source": "/progress/:path*", "destination": "/index.html" },
    { "source": "/users/:path*", "destination": "/index.html" }
  ]
}
